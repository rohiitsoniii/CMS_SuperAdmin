# CMS Super Admin — environment template
# Copy to .env and adjust.

# Backend API base (dev proxy handles /api → :5000, so this is optional)
VITE_API_URL=/api/v1

# Optional: direct backend URL (bypasses vite proxy)
# VITE_API_URL=http://localhost:5000/api/v1

# App metadata
VITE_APP_NAME=CMS Super Admin
VITE_APP_VERSION=1.0.0
